# =============================================================================
# MUCodeX — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to Git.
# =============================================================================

# --- Database (PostgreSQL) ---
# Local development:  postgresql://postgres:yourpassword@localhost:5432/mucodex
# Neon (production):  Find this in your Neon project dashboard → Connection string
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mucodex

# --- Node Environment ---
# Use "development" locally, "production" on Vercel/Railway/Render
NODE_ENV=development
